MONGODB_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CRON_SECRET=

# Groq API keys — add up to 5 for automatic rate-limit rotation.
# Keys are tried in order; rotation only occurs when a key returns HTTP 429.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

AI_DAILY_LIMIT=15

# Sentry error observability (free tier — 5,000 errors/month).
# Create a free Next.js project at https://sentry.io and paste the DSN below.
# Both vars should have the same value; SENTRY_DSN is server-only,
# NEXT_PUBLIC_SENTRY_DSN is also sent to the client bundle (for ErrorBoundary).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
